{
  "_README": "GameBoost 配置。protectShells=保护终端家族(cmd/powershell/conhost/WindowsTerminal 等，默认 true)；skipSession0=跳过会话 0 的服务进程(默认 true，更安全)；hostProtected=宿主/编辑器名单，默认保护，-IncludeAgent 可解除；safeTargets=Safe 范围白名单(支持 * 通配)；idleByDefault=命中时即使 -Mode Suspend 也改走 Idle 软模式(只降 QoS 不冻结)，适合 IM/同步/办公类以免断消息或丢自动保存。反作弊、杀毒、系统关键进程为脚本内硬编码保护，本文件无法解除。",
  "protectShells": true,
  "skipSession0": true,
  "hostProtected": [
    "code",
    "devenv",
    "pycharm64",
    "idea64",
    "webstorm64",
    "goland64",
    "rider64",
    "sublime_text",
    "notepad++",
    "node",
    "deno",
    "bun"
  ],
  "idleByDefault": [
    "Weixin",
    "WeChat",
    "WeChatAppEx",
    "QQ",
    "TIM",
    "DingTalk",
    "OneDrive",
    "OneDrive.Sync.Service",
    "Dropbox",
    "GoogleDriveFS",
    "BaiduNetdisk",
    "wps",
    "wpscloudsvr",
    "promecefpluginhost",
    "OfficeClickToRun",
    "MSOfficePLUSService",
    "SDXHelper"
  ],
  "_safeTargets_NOTE": "下面只是「常见可冻结的后台应用」示例清单，请按自己的机器增删。注意：游戏启动器/平台客户端（steam、EpicGamesLauncher、Battle.net、EADesktop、RiotClientServices 等）故意没有放进来 —— 冻结它们可能让游戏 DRM/反作弊校验失败或丢失好友/成就上报。",
  "safeTargets": [
    "chrome",
    "msedge",
    "msedgewebview2",
    "firefox",
    "brave",
    "opera",
    "vivaldi",
    "chromium",
